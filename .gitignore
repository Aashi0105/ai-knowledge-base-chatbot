.pytest_cache/
.coverage
htmlcov/

# Local database & data contents (preserve .gitkeep)
chroma_db/*
!chroma_db/.gitkeep
data/*
!data/.gitkeep

# Uploaded documents & temporary files
uploads/
tmp/
temp/
*.tmp
*.log

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
